# ============================================================
# OnMyOwnTrip .gitignore
#   - No subimos archivos temporales, logs, ni scripts locales de servidor
# ============================================================

# ---- OS / Editor ----
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.trae/
.claude/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- Logs & TMP ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.cache

# ---- Screenshots locales / dev artifacts ----
screenshots/
screenshot-*.png
*.png~
*.jpg~

# ---- Scripts locales de servidor (no se suben) ----
serve-*.ps1
*.ps1
!README*.ps1

# ---- Node (por si alguien lo usa luego) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
dist/
build/

# ---- Capacitor: carpeta generada por scripts/build-www.js ----
www/

# ---- Android / Gradle: solo se versiona el código fuente del proyecto,
#      no lo que Gradle genera al compilar (pesa mucho y es distinto en
#      cada máquina) ----
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/app/debug/
android/local.properties
android/captures/
android/*.iml
android/app/*.iml
*.jks
*.keystore

# ---- PowerShell history & sandbox ----
ConsoleHost_history.txt
_TRaeSandbox/

# ---- Configuración local de IA (API keys) — NUNCA se sube ----
llm-config.js

# ---- Contenido de ciudades (V26, gate detrás del Worker): el contenido real
#      de cada ciudad (pois[]) ya no vive en git, solo en la KV CITY_CONTENT
#      de Cloudflare y en el backup local. Esta carpeta se recrea localmente
#      solo para poder correr scripts/validate-data.js y
#      scripts/build-city-content.js — ver scratchpad/deploy-steps-content-gating.md ----
data/cities/
